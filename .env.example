# Copy to .env and fill in from Supabase Dashboard -> Project Settings -> API
# VITE_SUPABASE_URL is the *API* URL (https://<ref>.supabase.co), not the dashboard URL.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Web Push public key (README → Notifications). Leave empty to hide the feature.
VITE_VAPID_PUBLIC_KEY=
